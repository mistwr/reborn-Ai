# Reborn AI — example environment configuration
# Copy this file to .env.local and fill values locally or in your deployment provider.

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# LUMIN Connector Hub — OAuth apps
# Google connectors can reuse GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET, but the
# OAuth client must also allow:
#   https://YOUR_DOMAIN/api/connectors/oauth/callback/google
GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=

# GitHub OAuth App callback:
#   https://YOUR_DOMAIN/api/connectors/oauth/callback/github
GITHUB_CONNECTOR_CLIENT_ID=
GITHUB_CONNECTOR_CLIENT_SECRET=

# Meta app callback:
#   https://YOUR_DOMAIN/api/connectors/oauth/callback/meta
META_CONNECTOR_APP_ID=
META_CONNECTOR_APP_SECRET=

# Canva app callback:
#   https://YOUR_DOMAIN/api/connectors/oauth/callback/canva
CANVA_CONNECTOR_CLIENT_ID=
CANVA_CONNECTOR_CLIENT_SECRET=

# Figma OAuth app callback:
#   https://YOUR_DOMAIN/api/connectors/oauth/callback/figma
FIGMA_CONNECTOR_CLIENT_ID=
FIGMA_CONNECTOR_CLIENT_SECRET=

# Netlify OAuth app callback:
#   https://YOUR_DOMAIN/api/connectors/oauth/callback/netlify
NETLIFY_CONNECTOR_CLIENT_ID=
NETLIFY_CONNECTOR_CLIENT_SECRET=

# Founder / owner access (comma-separated emails). Evaluated server-side only.
REBORN_OWNER_EMAILS=

# Development-only credentials login. Disabled in production by code.
AUTH_ENABLE_DEMO_CREDENTIALS=false
AUTH_DEMO_PASSWORD=

# AI routing (Vercel AI Gateway model IDs use provider/model)
# Verified working on the current Preview free tier:
AI_MODEL=google/gemini-2.5-flash-lite
# Vision falls back to AI_MODEL when an explicit vision model is not configured.
AI_VISION_MODEL=google/gemini-2.5-flash-lite
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Optional providers / integrations
GOOGLE_GENERATIVE_AI_API_KEY=
HUGGINGFACE_API_KEY=
UNSPLASH_ACCESS_KEY=
ASSEMBLYAI_API_KEY=

# Optional public support contact (digits only, country code included, e.g. 3519XXXXXXXX)
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Optional campaign measurement
NEXT_PUBLIC_META_PIXEL_ID=
# Server-side Meta Conversions API. Keep the access token server-only.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0

# Reborn billing persistence (server-side only; points only to reborn_subscriptions)
REBORN_SUPABASE_URL=
REBORN_SUPABASE_SERVICE_ROLE_KEY=

# Deployment / payments
VERCEL_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
