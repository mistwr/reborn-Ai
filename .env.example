# Reborn AI — example environment configuration
# Copy this file to .env.local and fill values locally or in your deployment provider.

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Founder / owner access (comma-separated emails). Evaluated server-side only.
REBORN_OWNER_EMAILS=

# Development-only credentials login. Disabled in production by code.
AUTH_ENABLE_DEMO_CREDENTIALS=false
AUTH_DEMO_PASSWORD=

# AI routing (Vercel AI Gateway model IDs use provider/model)
AI_MODEL=google/gemini-3.6-flash
AI_VISION_MODEL=google/gemini-3.1-pro-preview
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Optional providers / integrations
GOOGLE_GENERATIVE_AI_API_KEY=
HUGGINGFACE_API_KEY=
UNSPLASH_ACCESS_KEY=

# Optional public support contact (digits only, country code included, e.g. 3519XXXXXXXX)
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Optional campaign measurement
NEXT_PUBLIC_META_PIXEL_ID=
# Server-side Meta Conversions API. Keep the access token server-only.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0

# Reborn billing persistence (server-side only; points only to reborn_subscriptions)
REBORN_SUPABASE_URL=
REBORN_SUPABASE_SERVICE_ROLE_KEY=

# Deployment / payments
VERCEL_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
